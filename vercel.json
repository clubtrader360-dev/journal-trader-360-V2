{
  "functions": {
    "api/cron/weekly-report.js": { "includeFiles": "api/cron/_lib/fonts/**" },
    "api/preview/weekly-report.js": { "includeFiles": "api/cron/_lib/fonts/**" }
  },
  "crons": [
    {
      "path": "/api/cron/replays-sync",
      "schedule": "0 18 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
