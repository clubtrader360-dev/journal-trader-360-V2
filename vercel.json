{
  "functions": {
    "api/cron/weekly-report.js": { "includeFiles": "api/cron/_lib/fonts/**" },
    "api/preview/weekly-report.js": { "includeFiles": "api/cron/_lib/fonts/**" },
    "api/coach/membres.js": { "includeFiles": "assets/marque/t360-logo-or.png" },
    "api/webhook/journal-entry.js": { "includeFiles": "assets/formation-{donnees,quiz,certification}.js" }
  },
  "crons": [
    {
      "path": "/api/cron/replays-sync",
      "schedule": "0 18 * * 1-5"
    },
    {
      "path": "/api/webhook/journal-entry?action=daily-recalc&utc=4",
      "schedule": "0 4 * * 1-5"
    },
    {
      "path": "/api/webhook/journal-entry?action=daily-recalc&utc=5",
      "schedule": "0 5 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
