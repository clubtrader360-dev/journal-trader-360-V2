# ============================================
# Variables d'environnement — Journal Trader 360
# ============================================
# Copier ce fichier vers .env (jamais commité) et y mettre les vraies valeurs.
# En production : configurer ces variables dans Vercel > Project Settings > Environment Variables.
# ============================================

# --- Backend / Vercel cron (api/cron/weekly-report.js) ---
# Clé service_role Supabase (CONFIDENTIELLE — bypasse RLS, accès admin DB)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Clé API Resend pour l'envoi d'emails (CONFIDENTIELLE)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret partagé pour authentifier les requêtes Vercel cron (optionnel mais recommandé)
CRON_SECRET=changeme-a-random-string

# --- Backend / Cron replays-sync (api/cron/replays-sync.js) ---
# Webhook Discord DÉDIÉE au salon "ajouts de replays" — distincte des autres
# notifs Discord du projet.
# Soit une webhook Discord directe (https://discord.com/api/webhooks/...),
# soit l'URL d'un proxy qui accepte le même contrat POST JSON {content: "..."}.
# Si absente : le cron log un warning et continue la sync (ne plante pas).
DISCORD_REPLAYS_WEBHOOK_URL=

# --- Backend / Routes Tradovate (api/tradovate/*) ---
# Clé de chiffrement AES-256-GCM pour les credentials Tradovate des élèves.
# CONFIDENTIELLE — la perdre rend les creds chiffrées DB illisibles.
# La leak rend les creds DB déchiffrables → rotater immédiatement (déconnecter
# tous les élèves, regénérer la clé, demander reconnexion).
# Générer avec : openssl rand -hex 32
TRADOVATE_ENCRYPTION_KEY=change_me_64_hex_chars

# --- Backend / Routes Vimeo (api/vimeo/*) ---
# Token d'accès personnel Vimeo (CONFIDENTIEL — jamais côté client).
# Créer une app sur https://developer.vimeo.com/apps puis générer un
# personal access token avec scopes "public" + "private" (lecture seule
# des vidéos du compte). Ne JAMAIS lui donner d'écriture/upload.
VIMEO_ACCESS_TOKEN=

# --- Frontend (supabase-config.js) ---
# Note : SUPABASE_ANON_KEY n'est PAS un secret. Elle est exposée côté client par design.
# Sa sécurité dépend ENTIÈREMENT des policies RLS configurées sur Supabase.
# → Vérifier que RLS est activé sur TOUTES les tables : users, accounts, trades,
#   journal_entries, daily_fees, account_costs, payouts, user_motivation,
#   tradovate_credentials, tradovate_sync_state.
